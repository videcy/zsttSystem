# Copy this file to .env and replace placeholder values.

# DeepSeek-compatible LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash
RERANK_MODEL=deepseek-v4-flash
JUDGE_MODEL=deepseek-v4-flash

# Embedding
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_CHARS=3000
SIMPLE_EMBEDDING_DIMENSIONS=384

# ChromaDB
# http: use the service from docker-compose.yml
# local: persist directly under VECTOR_DB_PATH without Docker
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION=zstt_chunks
VECTOR_DB_PATH=chroma_data

# Local Neo4j Community from docker-compose.yml
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Paths
QUERY_LOG_PATH=outputs/query_log.jsonl
FEEDBACK_LOG_PATH=outputs/feedback_log.jsonl
TRAINING_PLAN_DIR=data/training_plans
SYLLABUS_DIR=data/syllabi
COURSES_OUTPUT_PATH=outputs/courses.json
CHUNKS_OUTPUT_PATH=outputs/chunks.json
CONCEPT_CACHE_PATH=outputs/concept_cache.json
GRAPH_MANIFEST_PATH=outputs/graph_manifest.json
CONCEPT_REGISTRY_PATH=outputs/concept_registry.json
CONCEPT_VERIFIED_EDGE_PATH=outputs/concept_verified_edges.json
CONCEPT_ALIAS_PATH=outputs/concept_aliases.json
CONCEPT_CANDIDATE_EDGE_PATH=outputs/concept_candidate_edges.json
CONCEPT_EXTRACTION_CACHE_PATH=outputs/concept_extraction_cache.json
CONCEPT_VALIDATION_CACHE_PATH=outputs/concept_validation_cache.json
CONCEPT_NORMALIZATION_MODEL=BAAI/bge-large-zh-v1.5
CONCEPT_RETRIEVAL_MODEL=BAAI/bge-large-zh-v1.5

# Concept normalization
CONCEPT_CLUSTER_THRESHOLD=0.84
CONCEPT_TOP_K=5
CONCEPT_CANDIDATE_MIN_CONFIDENCE=0.45
CONCEPT_VERIFIED_MIN_CONFIDENCE=0.6
CONCEPT_MAX_VERIFICATION_CANDIDATES=500
CONCEPT_MIN_EXTRACTION_COVERAGE=0.1
CONCEPT_COURSE_ORDER_BONUS=0.3
CONCEPT_CROSS_DISCIPLINE_DECAY=0.85
CONCEPT_SCORE_WEIGHT_VECTOR=0.2
CONCEPT_SCORE_WEIGHT_STRUCTURE=0.2
CONCEPT_SCORE_WEIGHT_RULE=0.2
CONCEPT_WIKIPEDIA_ENABLED=false
CONCEPT_LLM_VOTE_COUNT=3
CONCEPT_API_CONCURRENCY=4
CONCEPT_LLM_VOTE_TEMPERATURE=0.2
RESET_CONCEPT_SUBGRAPH=false

# NLI verification
NLI_VERIFICATION_ENABLED=true
NLI_ENTAILMENT_THRESHOLD=0.6
NLI_MAX_RETRIES=1

# Retrieval reranking
# Weights are swept by eval/tune_rerank.py; the defaults reproduce the
# hand-tuned values used before the sweep existed.
RERANK_WEIGHT_VECTOR=0.75
RERANK_WEIGHT_LEXICAL=0.15
RERANK_SECTION_BOOST=0.08
# bm25 (IDF-weighted, needs outputs/lexical_stats.json) | overlap | none
RERANK_LEXICAL_SCHEME=bm25
RERANK_BM25_K1=1.5
RERANK_BM25_B=0.75
RERANK_CANDIDATE_MULTIPLIER=4
LEXICAL_STATS_PATH=outputs/lexical_stats.json

# Versioned collections (retraining rounds build zstt_chunks_v<n>)
COLLECTION_ALIAS_PATH=outputs/collection_alias.json

# Graph
# Chunk text lives in Chroma; mirroring it into Neo4j adds nodes no query reads
GRAPH_INCLUDE_CHUNK_NODES=false

# API surface
API_MAX_QUERY_CHARS=500
API_RATE_LIMIT_PER_MINUTE=60
# Comma-separated origins; empty disables CORS entirely
API_CORS_ORIGINS=

# Evaluation
EVAL_DATASET_PATH=eval/datasets/gold_questions.json
EVAL_REPORT_DIR=eval/reports
