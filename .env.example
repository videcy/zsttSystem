# Copy this file to .env and replace placeholder values.

# DeepSeek-compatible LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash
RERANK_MODEL=deepseek-v4-flash
JUDGE_MODEL=deepseek-v4-flash

# Embedding
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_CHARS=3000
SIMPLE_EMBEDDING_DIMENSIONS=384

# ChromaDB
# http: use the service from docker-compose.yml
# local: persist directly under VECTOR_DB_PATH without Docker
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION=zstt_chunks
VECTOR_DB_PATH=chroma_data

# Local Neo4j Community from docker-compose.yml
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Paths
QUERY_LOG_PATH=outputs/query_log.jsonl
FEEDBACK_LOG_PATH=outputs/feedback_log.jsonl
TRAINING_PLAN_DIR=data/training_plans
SYLLABUS_DIR=data/syllabi
COURSES_OUTPUT_PATH=outputs/courses.json
CHUNKS_OUTPUT_PATH=outputs/chunks.json
CONCEPT_CACHE_PATH=outputs/concept_cache.json
GRAPH_MANIFEST_PATH=outputs/graph_manifest.json
CONCEPT_REGISTRY_PATH=outputs/concept_registry.json
CONCEPT_VERIFIED_EDGE_PATH=outputs/concept_verified_edges.json

# Concept normalization
CONCEPT_CLUSTER_THRESHOLD=0.84
CONCEPT_TOP_K=5
CONCEPT_COURSE_ORDER_BONUS=0.3
CONCEPT_CROSS_DISCIPLINE_DECAY=0.85
CONCEPT_SCORE_WEIGHT_VECTOR=0.2
CONCEPT_SCORE_WEIGHT_STRUCTURE=0.2
CONCEPT_SCORE_WEIGHT_RULE=0.2
CONCEPT_SCORE_WEIGHT_EXTERNAL=0.4
CONCEPT_WIKIPEDIA_ENABLED=true
CONCEPT_LLM_VOTE_COUNT=3
CONCEPT_API_CONCURRENCY=4
CONCEPT_LLM_VOTE_TEMPERATURE=0.2

# NLI verification
NLI_ENTAILMENT_THRESHOLD=0.6
NLI_MAX_RETRIES=1
